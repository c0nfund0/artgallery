# Copy to .env and adjust. Gallery name and open registration are set in the
# first-run setup screen and later under Admin → Gallery settings.

# Image the server runs and auto-updates from (built by .github/workflows/release.yml).
GALLERY_IMAGE=ghcr.io/c0nfund0/artgallery:latest

# Optional: choose the first-run setup code yourself instead of reading it from the log.
SETUP_TOKEN=

# Optional (recommended to leave unset): a 256-bit key is generated securely on
# first run and stored in the data volume as /data/secret_key (mode 0600).
# If you do set it, it must be 32+ characters.
SECRET_KEY=

MAX_UPLOAD_MB=25
# Uploads are refused when the data volume has less free space than this.
MIN_FREE_MB=512
# Gunicorn worker processes (each can hold ~250 MB while processing an upload).
WEB_CONCURRENCY=2

# BEHIND_PROXY, SESSION_COOKIE_SECURE and FORWARDED_ALLOW_IPS are fixed in
# compose.yaml because this deployment always sits behind the TLS proxy.
