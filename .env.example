# Copy to .env and adjust.
SITE_NAME=Atelier
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# (If unset, a key is generated and stored in the data volume.)
SECRET_KEY=
# Anyone may create an artist account. The first account is always allowed and becomes admin.
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25
# Set both to true when serving over HTTPS behind a reverse proxy (recommended).
SESSION_COOKIE_SECURE=false
BEHIND_PROXY=false
FORWARDED_ALLOW_IPS=*

# Image the server runs and auto-updates from (built by .github/workflows/release.yml).
GALLERY_IMAGE=ghcr.io/c0nfund0/artgallery:latest
